import os

from dotenv import load_dotenv
from langchain_community.vectorstores.azuresearch import AzureSearch
from langchain_huggingface import HuggingFaceEmbeddings

load_dotenv()

#### Create the embedding models

embeddings = HuggingFaceEmbeddings(
    model_name="sentence-transformers/all-mpnet-base-v2",
    encode_kwargs={"normalize_embeddings": True},
)

#### Create the Azure vector store

vector_store = AzureSearch(
    azure_search_endpoint=os.environ["AZURE_SEARCH_ENDPOINT"],
    azure_search_key=os.environ["AZURE_SEARCH_KEY"],
    index_name=os.environ["AZURE_SEARCH_INDEX"],
    embedding_function=embeddings.embed_query,
)



#### Upload documents
import pypdf
from langchain_core.documents import Document
# Below is a minimal helper for demonstration purposes.
def load_pdf_pages(file_path: str) -> list[Document]:
    reader = pypdf.PdfReader(file_path)
    return [
        Document(
            page_content=page.extract_text() or "",
            metadata={"source": file_path, "page": i},
        )
        for i, page in enumerate(reader.pages)
    ]

file_path = "./GOLD-2025-Report-v1.0-15Nov2024_WMV.pdf"
docs = load_pdf_pages(file_path)
print('Docs loaded')
from langchain_text_splitters import RecursiveCharacterTextSplitter

text_splitter = RecursiveCharacterTextSplitter(
    chunk_size=500, chunk_overlap=200, add_start_index=True
)
all_splits = text_splitter.split_documents(docs)
vector_store.add_documents(all_splits)
print('chunks added to vector store')

### Test Retrival
query = "What does FEV mean?"

results = vector_store.similarity_search(
    query=query,
    k=3,
)

for i, document in enumerate(results, start=1):
    print(f"\nResult {i}")
    print("Source:", document.metadata.get("source"))
    print(document.page_content)

print("Azure Search initialization completed.")
del vector_store